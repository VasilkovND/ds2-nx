+void RenderDk::BorrarRectangulo(ImagenDk& destino, int32_t x0, int32_t y0, int32_t x1, int32_t y1, const float* color,
+                                float z, uint8_t estencil) {
+  x0 = std::max(x0, 0);
+  y0 = std::max(y0, 0);
+  x1 = std::min(x1, int32_t(destino.ancho));
+  y1 = std::min(y1, int32_t(destino.alto));
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  AntesDeCambiarDestino(&destino);
+  AsegurarTrabajo();
+  EmitirCieloPendiente();
+  HacerBorradoPendiente(destino);         // a whole clear still pending goes first
+  RestaurarContenido(destino, false);     // the rest of the target must hold its content
+  CompletarBanda(destino, destino.alto, false, 0);
+  AntesDe3D();
+  MarcarGpu(kGpuBorrados);
+  DkCmdBuf cmd = nucleo_.comandos();
+  const DkImageView vista = VistaCompleta(destino.imagen);
+  if (destino.profundidad) {
+    dkCmdBufBindRenderTargets(cmd, nullptr, 0, &vista);
+  } else {
+    dkCmdBufBindRenderTarget(cmd, &vista, nullptr);
+  }
+  const DkScissor tijera = {uint32_t(x0), uint32_t(y0), uint32_t(x1 - x0), uint32_t(y1 - y0)};
+  dkCmdBufSetScissors(cmd, 0, &tijera, 1);
+  if (destino.profundidad) {
+    dkCmdBufClearDepthStencil(cmd, true, z, 0xFF, estencil);
+  } else {
+    dkCmdBufClearColorFloat(cmd, 0, DkColorMask_RGBA, color[0], color[1], color[2], color[3]);
+  }
+  borrado_previo_.erase(destino.serie);
+  OlvidarEstado();
+  g_.pase_valido = false;
+  g_.valido = false;  // the scissor is the clear's
+  const uint64_t clave = (uint64_t(destino.profundidad) << 63) | (uint64_t(uint32_t(x0)) << 42) |
+                         (uint64_t(uint32_t(y0)) << 28) | (uint64_t(uint32_t(x1)) << 14) | uint32_t(y1);
+  if (borrados_rectangulo_vistos_.size() < 512 && borrados_rectangulo_vistos_.insert(clave).second) {
+    REXLOG_INFO("[deko3d] clear of a rectangle only: {} {}x{} ({},{})-({},{})", destino.profundidad ? "depth" : "color",
+                destino.ancho, destino.alto, x0, y0, x1, y1);
+  }
+}
