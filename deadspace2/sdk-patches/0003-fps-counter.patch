+/*
+ * Stack sampling (1 ms, invasive), on from the start with perfil_pilas.flag or switched on and off during play with
+ * ZL+ZR+R (switch_input_driver.cpp): no file to copy to the card for one profiling run.
+ */
+std::atomic<bool> g_muestrear_pilas{false};
+
+extern "C" bool RexSwitchPerfStacksActive(void) { return g_muestrear_pilas.load(std::memory_order_relaxed); }
+
+extern "C" bool RexSwitchPerfToggleStacks(void) {
+  const bool nuevo = !g_muestrear_pilas.load(std::memory_order_relaxed);
+  g_muestrear_pilas.store(nuevo, std::memory_order_relaxed);
+  if (FILE* f = std::fopen(ReportPath().c_str(), "a")) {
+    std::fprintf(f, "\nMuestreo de pilas: %s (atajo ZL+ZR+R)\n", nuevo ? "activo (1 ms)" : "desactivado");
+    std::fclose(f);
+  }
+  return nuevo;
+}
