+namespace rex::ui {
+void FijarSuperposicion(std::vector<std::string> lineas) {
+  auto& s = rex::deko3d::LaSuperposicion();
+  std::lock_guard<std::mutex> cerrojo(s.candado);
+  if (lineas == s.lineas) return;
+  s.lineas = std::move(lineas);
+  ++s.version;
+}
