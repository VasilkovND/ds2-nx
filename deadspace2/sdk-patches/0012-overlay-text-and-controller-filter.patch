+++ b/include/rex/input/filtro_mando.h
@@ -0,0 +1,16 @@
+// A game's own use of the controller before the game sees it (an options menu opened with a button combination). The
+// Switch input driver calls the filter on every poll of a connected controller with the buttons held (HidNpadButton_*
+// bits) and the controller's slot; if it returns true the game sees that controller idle (no buttons, centered
+// sticks) for that poll.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::input {
+
+using FiltroMando = bool (*)(size_t ranura, uint64_t botones);
+void FijarFiltroMando(FiltroMando filtro);
+
+}  // namespace rex::input
